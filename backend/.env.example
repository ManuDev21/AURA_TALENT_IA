# Copia este archivo como .env y completa los valores. Nunca subas .env a Git.
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=aura_talent
DB_USER=aura_app
DB_PASSWORD=

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Opcional (Fase 8): clave de Google AI Studio
GEMINI_API_KEY=
